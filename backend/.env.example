# SQLite works out of the box. For Postgres: postgresql+psycopg2://user:pass@localhost/notes
DATABASE_URL=sqlite:///./notes.db

# AI summaries. Providers: gemini (free) | claude (paid) | demo (no key, simple fake summary)
LLM_PROVIDER=gemini
# Free key, no credit card: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-3.5-flash
# Only if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your_anthropic_key
CLAUDE_MODEL=claude-sonnet-5-5

# Meeting bot (Recall.ai), only needed for live meetings
RECALL_API_KEY=your_recall_key
RECALL_REGION=us-east-1
WEBHOOK_TOKEN=any-random-string
PUBLIC_URL=https://your-ngrok-url.ngrok-free.app